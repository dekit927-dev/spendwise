<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content" style="display: flex; align-items: center; justify-content: center; min-height: 75vh;">
  <div class="container" style="max-width: 460px;">
    <div class="glass-panel apple-reveal" style="padding: 40px 36px; border-radius: 24px; border: 1px solid var(--border-card); box-shadow: var(--shadow-lg);">
      <div style="text-align: center; margin-bottom: 28px;">
        <img src="/images/logo.svg?v=fintech_v3" alt="SpendWise Logo" style="width: 64px; height: 64px; border-radius: 18px; margin-bottom: 14px; box-shadow: 0 0 24px var(--brand-glow);">
        <h2 style="font-size: 1.85rem; margin-bottom: 6px; font-weight: 700; letter-spacing: -0.03em;">Welcome Back</h2>
        <p style="color: var(--text-muted); font-size: 0.94rem;">Sign in to your personal SpendWise account</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35); color: #FCA5A5; padding: 12px 16px; border-radius: 12px; font-size: 0.92rem; margin-bottom: 22px; display: flex; align-items: center; gap: 10px;">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/auth/login" method="POST">
        <div class="form-group">
          <label class="form-label">Email Address</label>
          <input type="email" id="login-email" name="email" class="form-control" placeholder="you@domain.com" value="<%= typeof email !== 'undefined' ? email : '' %>" required autocomplete="email">
        </div>

        <div class="form-group">
          <label class="form-label">Password</label>
          <input type="password" id="login-password" name="password" class="form-control" placeholder="••••••••" required autocomplete="current-password">
        </div>

        <div style="margin-bottom: 24px;">
          <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px;">
            <i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In
          </button>
        </div>
      </form>

      <!-- Quick Demo Access Box -->
      <div style="background: var(--bg-surface-elevated); border: 1px dashed var(--border-gold); border-radius: 14px; padding: 16px; margin-bottom: 22px; text-align: center;">
        <div style="font-size: 0.78rem; color: var(--gold); font-weight: 700; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.05em;">
          <i class="fa-solid fa-bolt"></i> Instant Demo Account
        </div>
        <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 10px;">Preloaded with sample transactions, active streaks, and smart insights.</p>
        <button type="button" class="btn btn-outline btn-sm" onclick="fillDemoCredentials()" style="width: 100%; justify-content: center; font-size: 0.84rem;">
          Autofill Demo (demo@spendwise.bt)
        </button>
      </div>

      <div style="text-align: center; font-size: 0.92rem; color: var(--text-muted);">
        Don't have an account? <a href="/register" style="font-weight: 600; color: var(--gold); text-decoration: underline;">Create an account</a>
      </div>
    </div>
  </div>
</main>

<script>
function fillDemoCredentials() {
  document.getElementById('login-email').value = 'demo@spendwise.bt';
  document.getElementById('login-password').value = 'password123';
}
</script>

<%- include('partials/footer') %>
