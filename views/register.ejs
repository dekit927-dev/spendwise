<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content" style="display: flex; align-items: center; justify-content: center; min-height: 85vh; padding: 40px 0;">
  <div class="container" style="max-width: 540px;">
    <div class="glass-panel apple-reveal" style="padding: 42px 36px; border-radius: 24px; border: 1px solid var(--border-card); box-shadow: var(--shadow-lg);">
      <div style="text-align: center; margin-bottom: 28px;">
        <img src="/images/logo.svg?v=fintech_v3" alt="SpendWise Logo" style="width: 64px; height: 64px; border-radius: 18px; margin-bottom: 12px; box-shadow: 0 0 24px var(--brand-glow);">
        <h2 style="font-size: 1.95rem; margin-bottom: 6px; font-weight: 700; letter-spacing: -0.03em;">Create Your Account</h2>
        <p style="color: var(--text-muted); font-size: 0.94rem;">Smart personal finance, budgeting, and habit tracking</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35); color: #FCA5A5; padding: 14px 18px; border-radius: 12px; font-size: 0.92rem; margin-bottom: 24px; display: flex; align-items: center; gap: 10px;">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/auth/register" method="POST">
        <!-- Account Fundamentals -->
        <div class="form-group">
          <label class="form-label">Full Name *</label>
          <input type="text" name="name" class="form-control" placeholder="e.g. Alex Dorji" value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>" required autocomplete="name">
        </div>

        <div class="form-group">
          <label class="form-label">Email Address *</label>
          <input type="email" name="email" class="form-control" placeholder="alex@example.com" value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>" required autocomplete="email">
        </div>

        <div class="form-group">
          <label class="form-label">Password *</label>
          <input type="password" name="password" class="form-control" placeholder="At least 6 characters" required autocomplete="new-password">
        </div>

        <!-- Personal Preferences Section -->
        <div style="background: var(--bg-surface-elevated); border: 1px solid var(--border-card); border-radius: 14px; padding: 20px; margin: 24px 0;">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
            <span class="badge badge-gold" style="font-size: 0.72rem;"><i class="fa-solid fa-sliders"></i> PREFERENCES</span>
            <span style="font-size: 0.85rem; color: var(--text-main); font-weight: 600;">Optional Profile Details</span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" style="font-size: 0.82rem;">Mobile Number</label>
              <input type="tel" name="phone_number" class="form-control" placeholder="+975 17xxxxxx" value="<%= typeof formData !== 'undefined' && formData.phone_number ? formData.phone_number : '' %>">
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" style="font-size: 0.82rem;">Monthly Income (<%= defaultCurrency || 'Nu.' %>)</label>
              <input type="number" step="0.01" name="monthly_income" class="form-control" placeholder="e.g. 25000" value="<%= typeof formData !== 'undefined' && formData.monthly_income ? formData.monthly_income : '' %>" style="font-weight: 600;">
            </div>
          </div>
        </div>

        <!-- Preferred Currency -->
        <div class="form-group">
          <label class="form-label">Preferred Currency</label>
          <select name="currency" class="form-control form-select">
            <option value="Nu." selected>Nu. (Ngultrum)</option>
            <option value="₹">₹ (INR)</option>
            <option value="$">$ (USD)</option>
            <option value="€">€ (EUR)</option>
            <option value="£">£ (GBP)</option>
          </select>
        </div>

        <div style="margin-top: 24px; margin-bottom: 22px;">
          <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; justify-content: center;">
            <i class="fa-solid fa-sparkles"></i> Create Free Account
          </button>
        </div>
      </form>

      <div style="text-align: center; font-size: 0.92rem; color: var(--text-muted);">
        Already have an account? <a href="/login" style="font-weight: 600; color: var(--gold); text-decoration: underline;">Sign in here</a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
