<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content">
  <div class="container">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 26px;">
      <div>
        <span class="badge badge-gold" style="margin-bottom: 6px;">
          <i class="fa-solid fa-clock-rotate-left"></i> SCHEDULED DISBURSEMENTS
        </span>
        <h1 style="font-size: 2.2rem; margin-bottom: 4px; color: var(--gold-pale);">Recurring Bills & Utilities</h1>
        <p style="color: var(--text-muted); font-size: 0.94rem;">Manage monthly BPC electricity, telecom, rent, and subscriptions with proactive alerts.</p>
      </div>

      <button class="btn btn-primary" data-open-modal="add-recurring-modal">
        <i class="fa-solid fa-plus"></i> Add Recurring Bill
      </button>
    </div>

    <% if (query && query.success) { %>
      <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); color: #34D399; padding: 14px 20px; border-radius: 12px; font-size: 0.94rem; margin-bottom: 22px; display: flex; align-items: center; gap: 10px; box-shadow: var(--shadow-sm);">
        <i class="fa-solid fa-circle-check"></i> Recurring bill configured and scheduled successfully!
      </div>
    <% } else if (query && query.deleted) { %>
      <div style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.35); color: #FB7185; padding: 14px 20px; border-radius: 12px; font-size: 0.94rem; margin-bottom: 22px; display: flex; align-items: center; gap: 10px;">
        <i class="fa-solid fa-trash"></i> Recurring bill entry removed.
      </div>
    <% } else if (query && query.toggled) { %>
      <div style="background: rgba(197, 160, 89, 0.15); border: 1px solid var(--border-gold); color: var(--gold-pale); padding: 14px 20px; border-radius: 12px; font-size: 0.94rem; margin-bottom: 22px; display: flex; align-items: center; gap: 10px;">
        <i class="fa-solid fa-arrows-rotate"></i> Recurring bill status updated.
      </div>
    <% } else if (query && query.error) { %>
      <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35); color: #F87171; padding: 14px 20px; border-radius: 12px; font-size: 0.94rem; margin-bottom: 22px; display: flex; align-items: center; gap: 10px;">
        <i class="fa-solid fa-triangle-exclamation"></i> <%= query.error %>
      </div>
    <% } %>

    <!-- Recurring Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 24px;">
      <% if (recurringItems && recurringItems.length > 0) { %>
        <% recurringItems.forEach(r => { %>
          <div class="glass-panel apple-reveal" style="padding: 26px; border-left: 4px solid <%= r.is_active ? 'var(--gold)' : 'var(--text-subtle)' %>;">
            <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px;">
              <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 44px; height: 44px; border-radius: 10px; background: <%= r.category_color ? r.category_color + '22' : 'rgba(197, 160, 89, 0.15)' %>; display: flex; align-items: center; justify-content: center; color: <%= r.category_color || 'var(--gold)' %>; font-size: 1.15rem; border: 1px solid var(--border-gold);">
                  <i class="fa-solid <%= r.category_icon || 'fa-calendar' %>"></i>
                </div>
                <div>
                  <h3 style="font-size: 1.2rem; margin-bottom: 2px; color: var(--gold-pale);"><%= r.title %></h3>
                  <span style="font-size: 0.8rem; color: var(--text-muted);"><%= r.category_name || 'General Utility' %> &bull; <%= r.frequency %></span>
                </div>
              </div>

              <!-- Delete form -->
              <form action="/recurring/delete/<%= r.id %>" method="POST" onsubmit="return confirm('Remove this recurring bill?');" style="margin: 0;">
                <button type="submit" class="btn btn-outline btn-sm" style="padding: 4px 8px; color: #FB7185;" title="Remove">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </form>
            </div>

            <!-- Amount and Status -->
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px;">
              <div style="font-size: 1.6rem; font-weight: 800; font-family: 'Outfit', sans-serif; color: var(--text-main); letter-spacing: -0.02em;">
                <%= currency %> <%= parseFloat(r.amount).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                <span style="font-size: 0.8rem; font-weight: 500; color: var(--text-subtle); font-family: 'Plus Jakarta Sans', sans-serif;">/ cycle</span>
              </div>
              <span class="badge <%= r.is_active ? 'badge-gold' : 'badge-crimson' %>">
                <%= r.is_active ? 'Active' : 'Paused' %>
              </span>
            </div>

            <!-- Due Date & Actions -->
            <div style="background: var(--bg-surface-elevated); border: 1px solid var(--border-card); border-radius: 12px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; font-size: 0.86rem;">
              <div>
                <span style="color: var(--text-muted);"><i class="fa-solid fa-clock"></i> Next Due: </span>
                <strong style="color: #F59E0B; font-family: 'Outfit', sans-serif; font-weight: 700;"><%= new Date(r.next_due_date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %></strong>
              </div>

              <form action="/recurring/toggle/<%= r.id %>" method="POST" style="margin: 0;">
                <button type="submit" class="btn btn-outline btn-sm" style="padding: 4px 10px; font-size: 0.78rem;">
                  <i class="fa-solid <%= r.is_active ? 'fa-pause' : 'fa-play' %>"></i> <%= r.is_active ? 'Pause' : 'Resume' %>
                </button>
              </form>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="glass-panel" style="grid-column: 1 / -1; padding: 48px 20px; text-align: center; color: var(--text-muted);">
          <i class="fa-solid fa-clock-rotate-left" style="font-size: 3rem; margin-bottom: 14px; color: var(--gold); opacity: 0.5;"></i>
          <h3 style="font-family: 'Outfit', sans-serif; font-size: 1.35rem; font-weight: 700; margin-bottom: 6px; color: var(--text-main);">No Recurring Bills Set Up</h3>
          <p style="margin-bottom: 22px; max-width: 520px; margin-left: auto; margin-right: auto;">Keep track of upcoming electricity bills, subscriptions, internet fiber, or rent with automated reminders.</p>
          <button class="btn btn-primary" data-open-modal="add-recurring-modal">
            <i class="fa-solid fa-plus"></i> Add Recurring Bill
          </button>
        </div>
      <% } %>
    </div>
  </div>
</main>

<!-- Add Recurring Modal -->
<div id="add-recurring-modal" class="modal-backdrop">
  <div class="modal-box">
    <div class="modal-header">
      <h3 style="font-size: 1.25rem; color: var(--gold-pale);">New Recurring Bill</h3>
      <button type="button" data-close-modal style="background: none; border: none; color: var(--gold); font-size: 1.4rem; cursor: pointer;">&times;</button>
    </div>
    <form action="/recurring" method="POST">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Bill Title *</label>
          <input type="text" name="title" class="form-control" placeholder="e.g. BPC Electricity Bill or Home Internet" required>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
          <div class="form-group">
            <label class="form-label">Amount in Ngultrum (<%= currency %>) *</label>
            <input type="number" step="0.01" name="amount" class="form-control" placeholder="1250.00" required style="font-weight: 600;">
          </div>
          <div class="form-group">
            <label class="form-label">Category</label>
            <select name="category_id" class="form-control form-select">
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.name %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
          <div class="form-group">
            <label class="form-label">Billing Day (1–31) *</label>
            <input type="number" min="1" max="31" name="billing_day" class="form-control" value="1" required>
          </div>
          <div class="form-group">
            <label class="form-label">Next Due Date *</label>
            <input type="date" name="next_due_date" class="form-control" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Payment Channel</label>
          <select name="payment_method" class="form-control form-select">
            <option value="BoB mBoB">BoB (mBoB)</option>
            <option value="BNB mPay">BNB (mPay)</option>
            <option value="BDBL e-Banking">BDBL e-Banking</option>
            <option value="Mobile Wallet (e-Teeru)">Mobile Wallet (e-Teeru)</option>
            <option value="Cash">Cash (Ngultrum)</option>
            <option value="Bank Transfer">Bank Transfer</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Notes / Consumer No. (Optional)</label>
          <input type="text" name="notes" class="form-control" placeholder="e.g. BPC Meter #482910 or Account Ref">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-close-modal>Cancel</button>
        <button type="submit" class="btn btn-primary">Schedule Recurring Bill</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/quick-add-modal') %>
<%- include('partials/zero-spending-modal') %>
<%- include('partials/footer') %>
