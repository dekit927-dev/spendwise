<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'SpendWise – Smart Personal Finance & Gamified Tracking' %></title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg?v=fintech_v3">
  <link rel="alternate icon" type="image/png" href="/images/logo.png?v=fintech_v3">

  <!-- Google Fonts (Modern Relatable Typography: Inter & Plus Jakarta Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Custom Design System -->
  <link rel="stylesheet" href="/css/style.css?v=2026">

  <!-- Socket.IO Client -->
  <script src="/socket.io/socket.io.js"></script>

  <!-- Instant Theme Initializer -->
  <script>
    (function () {
      const savedTheme = localStorage.getItem('spendwise_theme') || 'royal';
      if (savedTheme) {
        document.documentElement.setAttribute('data-theme', savedTheme);
      }
    })();
  </script>

  <!-- Chart.js 4 -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body data-user-id="<%= (typeof currentUser !== 'undefined' && currentUser) ? currentUser.id : '' %>">
