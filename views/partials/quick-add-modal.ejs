<!-- Quick Add Transaction Modal -->
<div id="quick-add-modal" class="modal-backdrop">
  <div class="modal-box">
    <div class="modal-header">
      <h3 style="font-size: 1.25rem; display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--text-main);">
        <i class="fa-solid fa-plus-circle" style="color: var(--gold);"></i> Add New Transaction
      </h3>
      <button type="button" data-close-modal style="background: none; border: none; color: var(--text-muted); font-size: 1.4rem; cursor: pointer;">&times;</button>
    </div>
    <form action="/transactions" method="POST" enctype="multipart/form-data">
      <div class="modal-body">
        <!-- Type Selection -->
        <div class="form-group" style="display: flex; gap: 12px; margin-bottom: 20px;">
          <label style="flex: 1; cursor: pointer;">
            <input type="radio" name="type" value="expense" checked style="display: none;" onchange="updateModalType('expense')">
            <div id="tab-expense" class="btn btn-primary" style="width: 100%; text-align: center; justify-content: center;">
              <i class="fa-solid fa-arrow-down"></i> Expense
            </div>
          </label>
          <label style="flex: 1; cursor: pointer;">
            <input type="radio" name="type" value="income" style="display: none;" onchange="updateModalType('income')">
            <div id="tab-income" class="btn btn-outline" style="width: 100%; text-align: center; justify-content: center;">
              <i class="fa-solid fa-arrow-up"></i> Income
            </div>
          </label>
        </div>

        <!-- Amount -->
        <div class="form-group">
          <label class="form-label">Amount (<%= typeof currency !== 'undefined' ? currency : 'Nu.' %>) *</label>
          <input type="number" step="0.01" name="amount" class="form-control" placeholder="0.00" required style="font-size: 1.2rem; font-weight: 700;">
        </div>

        <!-- Category -->
        <div class="form-group">
          <label class="form-label">Category</label>
          <select name="category_id" class="form-control form-select">
            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.name %> (<%= cat.type %>)</option>
              <% }); %>
            <% } else { %>
              <option value="1">Food & Dining</option>
              <option value="2">Transport</option>
              <option value="3">Shopping</option>
              <option value="4">Utilities</option>
              <option value="5">Mobile & Internet</option>
              <option value="11">Salary & Income</option>
            <% } %>
          </select>
        </div>

        <!-- Description -->
        <div class="form-group">
          <label class="form-label">Description *</label>
          <input type="text" name="description" class="form-control" placeholder="e.g. Groceries or Coffee" required>
        </div>

        <!-- Date & Payment Method -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
          <div class="form-group">
            <label class="form-label">Date *</label>
            <input type="date" name="transaction_date" class="form-control" required>
          </div>
          <div class="form-group">
            <label class="form-label">Payment Method</label>
            <select name="payment_method" class="form-control form-select">
              <option value="Bank App">Mobile Banking App</option>
              <option value="Debit Card">Debit / Credit Card</option>
              <option value="Cash">Cash</option>
              <option value="Digital Wallet">Digital Wallet</option>
              <option value="Bank Transfer">Bank Transfer</option>
            </select>
          </div>
        </div>

        <!-- Receipt Upload -->
        <div class="form-group">
          <label class="form-label">Receipt Image / Attachment (Optional)</label>
          <input type="file" name="receipt" accept="image/*,.pdf" class="form-control" style="padding: 8px 12px; font-size: 0.88rem;">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-close-modal>Cancel</button>
        <button type="submit" class="btn btn-primary">
          <i class="fa-solid fa-check"></i> Save Transaction
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function updateModalType(type) {
  const tabExp = document.getElementById('tab-expense');
  const tabInc = document.getElementById('tab-income');
  if (type === 'income') {
    tabInc.className = 'btn btn-primary';
    tabExp.className = 'btn btn-outline';
  } else {
    tabExp.className = 'btn btn-primary';
    tabInc.className = 'btn btn-outline';
  }
}

// Automatically preset today's date if empty
document.addEventListener('DOMContentLoaded', () => {
  const dateInput = document.querySelector('input[name="transaction_date"]');
  if (dateInput && !dateInput.value) {
    dateInput.value = new Date().toISOString().split('T')[0];
  }
});
</script>
