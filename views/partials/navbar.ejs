        <button type="button" class="mobile-palette-pill" onclick="window.SpendWise.setTheme('royal')">
          <span class="theme-swatch" style="background: linear-gradient(135deg, #FFFFFF 50%, #10B981 50%); border-color: #10B981;"></span> Mint
        </button>
        <button type="button" class="mobile-palette-pill" onclick="window.SpendWise.setTheme('pink')">
          <span class="theme-swatch" style="background: linear-gradient(135deg, #FBCFE8 50%, #EC4899 50%); border-color: #EC4899;"></span> Pink
        </button>
        <button type="button" class="mobile-palette-pill" onclick="window.SpendWise.setTheme('lavender')">
          <span class="theme-swatch" style="background: linear-gradient(135deg, #DDD6FE 50%, #8B5CF6 50%); border-color: #8B5CF6;"></span> Lilac
        </button>
      </div>

      <div class="mobile-section-label" style="margin-top: 18px;">Account</div>
      <a href="/profile" class="mobile-nav-link <%= currentPath === '/profile' ? 'active' : '' %>" onclick="window.SpendWise.closeMobileMenu()">
        <i class="fa-solid fa-user-gear"></i>
        <span>Profile & Settings</span>
      </a>
      <a href="/auth/logout" class="mobile-nav-link" style="color: #FB7185;">
        <i class="fa-solid fa-arrow-right-from-bracket"></i>
        <span>Sign Out</span>
      </a>
    </nav>
  <% } else { %>
    <nav class="mobile-links-list">
      <div class="mobile-section-label">Welcome To SpendWise</div>
      <a href="/login" class="mobile-nav-link" onclick="window.SpendWise.closeMobileMenu()">
