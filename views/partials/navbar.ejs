<nav class="navbar">
  <div class="container nav-container">
    <a href="<%= (typeof currentUser !== 'undefined' && currentUser) ? '/dashboard' : '/' %>" class="brand-logo">
      <img src="/images/logo.svg?v=fintech_v3" alt="SpendWise Logo" class="brand-logo-img">
      <div class="brand-text-block">
        <span class="brand-name">Spend<span class="gold-foil">Wise</span></span>
        <span class="brand-motto">Personal Finance</span>
      </div>
    </a>

    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <ul class="nav-links">
        <li>
          <a href="/dashboard" class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>">
            <i class="fa-solid fa-table-columns"></i> Dashboard
          </a>
        </li>
        <li>
          <a href="/transactions" class="nav-link <%= currentPath === '/transactions' ? 'active' : '' %>">
            <i class="fa-solid fa-receipt"></i> Transactions
          </a>
        </li>
        <li>
          <a href="/streaks" class="nav-link <%= currentPath === '/streaks' ? 'active' : '' %>">
            <i class="fa-solid fa-fire streak-flame"></i> Streak
          </a>
        </li>
        <li>
          <a href="/analytics" class="nav-link <%= currentPath === '/analytics' ? 'active' : '' %>">
            <i class="fa-solid fa-chart-pie"></i> Analytics
          </a>
        </li>
        <li>
          <a href="/budgets" class="nav-link <%= currentPath === '/budgets' ? 'active' : '' %>">
            <i class="fa-solid fa-wallet"></i> Budgets
          </a>
        </li>
        <li>
          <a href="/recurring" class="nav-link <%= currentPath === '/recurring' ? 'active' : '' %>">
            <i class="fa-solid fa-calendar-days"></i> Recurring
          </a>
        </li>
        <li>
          <a href="/reports" class="nav-link <%= (currentPath === '/reports' || currentPath === '/monthly-reports') ? 'active' : '' %>">
            <i class="fa-solid fa-file-invoice"></i> Reports
          </a>
        </li>
        <li>
          <a href="/suggestions" class="nav-link <%= currentPath === '/suggestions' ? 'active' : '' %>">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Insights
          </a>
        </li>
      </ul>

      <div class="nav-actions">
        <!-- Theme Palette Switcher -->
        <div class="theme-dropdown">
          <button type="button" class="btn btn-outline btn-sm" id="theme-menu-btn" title="Choose Theme Palette" onclick="window.SpendWise.toggleThemeMenu(event)">
            <i class="fa-solid fa-palette"></i>
          </button>
          <div class="theme-menu" id="theme-menu">
            <div style="font-size: 0.72rem; font-weight: 700; color: var(--gold); text-transform: uppercase; padding: 6px 10px; letter-spacing: 0.05em;">Aesthetic Themes</div>
            <button type="button" class="theme-option-btn" onclick="window.SpendWise.setTheme('obsidian')">
              <span class="theme-swatch" style="background: linear-gradient(135deg, #000000 50%, #38BDF8 50%); border-color: #38BDF8;"></span> Midnight Black
            </button>
            <button type="button" class="theme-option-btn" onclick="window.SpendWise.setTheme('royal')">
              <span class="theme-swatch" style="background: linear-gradient(135deg, #FFFFFF 50%, #10B981 50%); border-color: #10B981;"></span> Emerald Mint (Light)
            </button>
            <button type="button" class="theme-option-btn" onclick="window.SpendWise.setTheme('pink')">
              <span class="theme-swatch" style="background: linear-gradient(135deg, #FBCFE8 50%, #EC4899 50%); border-color: #EC4899;"></span> Sakura Blossom (Pink)
            </button>
            <button type="button" class="theme-option-btn" onclick="window.SpendWise.setTheme('lavender')">
              <span class="theme-swatch" style="background: linear-gradient(135deg, #DDD6FE 50%, #8B5CF6 50%); border-color: #8B5CF6;"></span> Lavender Dream (Lilac)
            </button>
          </div>
        </div>

        <!-- Quick Add Modal Trigger (Desktop/Laptop) -->
        <button class="btn btn-primary btn-sm desktop-only-action" data-open-modal="quick-add-modal">
          <i class="fa-solid fa-plus"></i> Add
        </button>

        <!-- Notifications Bell -->
        <a href="/notifications" class="btn btn-outline btn-sm notif-btn" style="position: relative; padding: 8px 12px;" title="Notifications">
          <i class="fa-solid fa-bell"></i>
          <span id="notif-badge-count" class="badge badge-crimson" style="position: absolute; top: -6px; right: -6px; padding: 2px 6px; font-size: 0.72rem; <%= (typeof unreadCount !== 'undefined' && unreadCount > 0) ? '' : 'display: none;' %>">
            <%= typeof unreadCount !== 'undefined' ? unreadCount : 0 %>
          </span>
        </a>

        <!-- Profile Link (Desktop/Laptop) -->
        <a href="/profile" class="btn btn-outline btn-sm desktop-user-btn" style="gap: 6px;">
          <i class="fa-solid fa-circle-user"></i>
          <span class="user-greeting-name"><%= currentUser.name.split(' ')[0] %></span>
        </a>

        <!-- Sign Out (Desktop/Laptop) -->
        <a href="/auth/logout" class="btn btn-outline btn-sm desktop-only-action" title="Sign Out">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </a>

        <!-- Mobile & Tablet Hamburger Toggle Button -->
        <button type="button" class="btn btn-outline btn-sm mobile-hamburger-btn" id="mobile-menu-toggle" aria-label="Toggle navigation menu" onclick="window.SpendWise.toggleMobileMenu()">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    <% } else { %>
      <div class="nav-actions">
        <!-- Theme Palette Switcher -->
        <div class="theme-dropdown">
          <button type="button" class="btn btn-outline btn-sm" title="Choose Theme Palette" onclick="window.SpendWise.toggleThemeMenu(event)">
            <i class="fa-solid fa-palette"></i>
          </button>
          <div class="theme-menu" id="theme-menu-guest">
            <div style="font-size: 0.72rem; font-weight: 700; color: var(--gold); text-transform: uppercase; padding: 6px 10px; letter-spacing: 0.05em;">Aesthetic Themes</div>
            <button type="button" class="theme-option-btn" onclick="window.SpendWise.setTheme('obsidian')">
              <span class="theme-swatch" style="background: linear-gradient(135deg, #000000 50%, #38BDF8 50%); border-color: #38BDF8;"></span> Midnight Black
            </button>
            <button type="button" class="theme-option-btn" onclick="window.SpendWise.setTheme('royal')">
              <span class="theme-swatch" style="background: linear-gradient(135deg, #FFFFFF 50%, #10B981 50%); border-color: #10B981;"></span> Emerald Mint (Light)
            </button>
            <button type="button" class="theme-option-btn" onclick="window.SpendWise.setTheme('pink')">
              <span class="theme-swatch" style="background: linear-gradient(135deg, #FBCFE8 50%, #EC4899 50%); border-color: #EC4899;"></span> Sakura Blossom (Pink)
            </button>
            <button type="button" class="theme-option-btn" onclick="window.SpendWise.setTheme('lavender')">
              <span class="theme-swatch" style="background: linear-gradient(135deg, #DDD6FE 50%, #8B5CF6 50%); border-color: #8B5CF6;"></span> Lavender Dream (Lilac)
            </button>
          </div>
        </div>

        <a href="/login" class="btn btn-outline btn-sm">Sign In</a>
        <a href="/register" class="btn btn-primary btn-sm guest-join-btn">Get Started</a>

        <button type="button" class="btn btn-outline btn-sm mobile-hamburger-btn" id="mobile-menu-toggle-guest" aria-label="Toggle navigation menu" onclick="window.SpendWise.toggleMobileMenu()">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    <% } %>
  </div>
</nav>

<!-- Mobile & Tablet Slide-out Drawer Navigation -->
<div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop" onclick="window.SpendWise.closeMobileMenu()"></div>
<aside class="mobile-nav-drawer" id="mobile-nav-drawer" aria-label="Mobile Navigation">
