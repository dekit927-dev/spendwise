      <div class="mobile-section-label" style="margin-top: 18px;">Aesthetic Themes</div>
      <div class="mobile-palettes-grid">
        <button type="button" class="mobile-palette-pill" onclick="window.SpendWise.setTheme('obsidian')">
          <span class="theme-swatch" style="background: linear-gradient(135deg, #000000 50%, #38BDF8 50%); border-color: #38BDF8;"></span> Black
