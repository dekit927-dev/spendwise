    <div class="mobile-drawer-brand">
      <img src="/images/logo.svg?v=fintech_v3" alt="SpendWise Logo">
      <div>
        <div class="mobile-brand-title">Spend<span class="gold-foil">Wise</span></div>
        <div class="mobile-brand-motto">Personal Finance</div>
      </div>
    </div>
    <button type="button" class="mobile-drawer-close" onclick="window.SpendWise.closeMobileMenu()" aria-label="Close Navigation">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
