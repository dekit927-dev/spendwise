      <a href="/dashboard" class="mobile-nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>" onclick="window.SpendWise.closeMobileMenu()">
        <i class="fa-solid fa-table-columns"></i>
        <span>Dashboard</span>
      </a>
      <a href="/transactions" class="mobile-nav-link <%= currentPath === '/transactions' ? 'active' : '' %>" onclick="window.SpendWise.closeMobileMenu()">
        <i class="fa-solid fa-receipt"></i>
        <span>Transactions</span>
      </a>
      <a href="/streaks" class="mobile-nav-link <%= currentPath === '/streaks' ? 'active' : '' %>" onclick="window.SpendWise.closeMobileMenu()">
        <i class="fa-solid fa-fire streak-flame"></i>
        <span>Habit Streak</span>
      </a>
      <a href="/analytics" class="mobile-nav-link <%= currentPath === '/analytics' ? 'active' : '' %>" onclick="window.SpendWise.closeMobileMenu()">
        <i class="fa-solid fa-chart-pie"></i>
        <span>Analytics</span>
      </a>
      <a href="/budgets" class="mobile-nav-link <%= currentPath === '/budgets' ? 'active' : '' %>" onclick="window.SpendWise.closeMobileMenu()">
        <i class="fa-solid fa-wallet"></i>
        <span>Budgets</span>
      </a>
      <a href="/recurring" class="mobile-nav-link <%= currentPath === '/recurring' ? 'active' : '' %>" onclick="window.SpendWise.closeMobileMenu()">
        <i class="fa-solid fa-calendar-days"></i>
        <span>Recurring Bills</span>
      </a>
      <a href="/reports" class="mobile-nav-link <%= (currentPath === '/reports' || currentPath === '/monthly-reports') ? 'active' : '' %>" onclick="window.SpendWise.closeMobileMenu()">
        <i class="fa-solid fa-file-invoice"></i>
        <span>Monthly Reports</span>
      </a>
      <a href="/suggestions" class="mobile-nav-link <%= currentPath === '/suggestions' ? 'active' : '' %>" onclick="window.SpendWise.closeMobileMenu()">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <span>Smart Insights</span>
