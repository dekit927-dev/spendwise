      </button>
      <a href="/notifications" class="btn btn-outline btn-sm" style="justify-content: center; position: relative;" onclick="window.SpendWise.closeMobileMenu()">
        <i class="fa-solid fa-bell"></i>
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
          <span class="badge badge-crimson" style="padding: 1px 5px; font-size: 0.68rem; margin-left: 4px;"><%= unreadCount %></span>
