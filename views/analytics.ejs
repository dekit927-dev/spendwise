<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content" id="analytics-page-root" data-month="<%= month %>" data-currency="<%= currency %>">
  <div class="container">
    <!-- Header with Month Switcher -->
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 26px;">
      <div>
        <span class="badge badge-gold" style="margin-bottom: 6px;">
          <i class="fa-solid fa-chart-pie"></i> FINANCIAL ANALYTICS
        </span>
        <h1 style="font-size: 2.2rem; margin-bottom: 4px; font-weight: 800; letter-spacing: -0.03em;">Spending Analytics & Trends</h1>
        <p style="color: var(--text-muted); font-size: 0.94rem;">Interactive visual breakdowns of your personal income, expenses, and savings.</p>
      </div>

      <div style="display: flex; align-items: center; gap: 12px;">
        <label style="font-size: 0.9rem; font-weight: 600; color: var(--text-main); font-family: 'Plus Jakarta Sans', sans-serif;">Period:</label>
        <form action="/analytics" method="GET" style="margin: 0;">
          <input type="month" name="month" class="form-control" value="<%= month %>" onchange="this.form.submit()" style="padding: 8px 16px; font-size: 0.92rem; width: auto; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 600;">
        </form>
      </div>
    </div>

    <!-- Monthly Summary Bar -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-bottom: 28px;">
      <div class="glass-panel metric-card apple-reveal" style="border-top: 3px solid var(--gold);">
        <div class="metric-label">
          <i class="fa-solid fa-arrow-trend-up" style="color: var(--gold);"></i> Inflow (<%= month %>)
        </div>
        <div class="metric-value" style="color: var(--gold-pale);">
          <%= currency %> <%= totals.total_income.toLocaleString(undefined, {minimumFractionDigits: 2}) %>
        </div>
        <div class="metric-sub">Monthly incoming funds</div>
      </div>

      <div class="glass-panel metric-card apple-reveal" style="border-top: 3px solid #8C1C13;">
        <div class="metric-label">
          <i class="fa-solid fa-arrow-trend-down" style="color: #F87171;"></i> Expenditure (<%= month %>)
        </div>
        <div class="metric-value" style="color: #FFFFFF;">
          <%= currency %> <%= totals.total_expense.toLocaleString(undefined, {minimumFractionDigits: 2}) %>
        </div>
        <div class="metric-sub">Total disbursements</div>
      </div>

      <div class="glass-panel metric-card apple-reveal" style="border-top: 3px solid <%= totals.net_savings >= 0 ? '#10B981' : '#E11D48' %>;">
        <div class="metric-label">
          <i class="fa-solid fa-vault" style="color: <%= totals.net_savings >= 0 ? '#34D399' : '#FB7185' %>;"></i> Preserved Wealth
        </div>
        <div class="metric-value" style="color: <%= totals.net_savings >= 0 ? '#34D399' : '#FB7185' %>;">
          <%= currency %> <%= totals.net_savings.toLocaleString(undefined, {minimumFractionDigits: 2}) %>
        </div>
        <div class="metric-sub">Retained balance</div>
      </div>
    </div>

    <!-- Charts Grid: Category Doughnut & Monthly Comparison -->
    <div class="charts-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 26px; margin-bottom: 28px;">
      <!-- Chart 1: Category Breakdown -->
      <div class="glass-panel apple-reveal" style="padding: 28px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
          <h3 style="font-size: 1.25rem; display: flex; align-items: gap: 10px; color: var(--gold-pale); margin: 0;">
            <i class="fa-solid fa-chart-pie" style="color: var(--gold);"></i> Category Allocation
          </h3>
          <span class="badge badge-gold"><%= month %></span>
        </div>
        <div style="height: 320px; position: relative;">
          <canvas id="categoryDoughnutChart"></canvas>
        </div>
      </div>

      <!-- Chart 2: Monthly Comparison -->
      <div class="glass-panel apple-reveal" style="padding: 28px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
          <h3 style="font-size: 1.25rem; display: flex; align-items: center; gap: 10px; color: var(--gold-pale); margin: 0;">
            <i class="fa-solid fa-chart-column" style="color: var(--gold);"></i> 6-Month Inflow vs Outflow
          </h3>
          <span class="badge badge-gold">Historical</span>
        </div>
        <div style="height: 320px; position: relative;">
          <canvas id="monthlyComparisonChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Chart 3: Daily Spending Trends Line Chart -->
    <div class="glass-panel apple-reveal" style="padding: 28px;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
        <h3 style="font-size: 1.25rem; display: flex; align-items: center; gap: 10px; color: var(--gold-pale); margin: 0;">
          <i class="fa-solid fa-chart-line" style="color: var(--gold);"></i> Daily Expenditure Trajectory (<%= month %>)
        </h3>
        <span class="badge badge-warning">Fluctuations</span>
      </div>
      <div style="height: 300px; position: relative;">
        <canvas id="dailyTrendsChart"></canvas>
      </div>
    </div>
  </div>
</main>

<script src="/js/analytics.js"></script>

<%- include('partials/quick-add-modal') %>
<%- include('partials/zero-spending-modal') %>
<%- include('partials/footer') %>
