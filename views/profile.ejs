<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content">
  <div class="container" style="max-width: 840px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 26px;">
      <div>
        <span class="badge badge-gold" style="margin-bottom: 6px;">
          <i class="fa-solid fa-user-gear"></i> PERSONAL PREFERENCES
        </span>
        <h1 style="font-size: 2.2rem; margin-bottom: 4px; color: var(--gold-pale);">Profile & Account Settings</h1>
        <p style="color: var(--text-muted); font-size: 0.94rem;">Manage your personal profile, notification preferences, and theme palette.</p>
      </div>
      <a href="/auth/logout" class="btn btn-outline btn-sm" style="color: #FB7185; border-color: rgba(244, 63, 94, 0.4); gap: 6px;">
        <i class="fa-solid fa-arrow-right-from-bracket"></i> Log Out
      </a>
    </div>

    <% if (query && query.success) { %>
      <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); color: #34D399; padding: 14px 20px; border-radius: 12px; font-size: 0.94rem; margin-bottom: 22px; display: flex; align-items: center; gap: 10px; box-shadow: var(--shadow-sm);">
        <i class="fa-solid fa-circle-check"></i> Profile preferences updated successfully!
      </div>
    <% } %>

    <form action="/auth/profile" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 24px;">
      <!-- Card 1: User Identity & Avatar -->
      <div class="glass-panel apple-reveal" style="padding: 32px; border-radius: 20px;">
        <div style="display: flex; align-items: center; gap: 24px; flex-wrap: wrap;">
          <div class="profile-avatar-wrapper">
            <% const hasCustomAvatar = currentUser.avatar && !currentUser.avatar.includes('logo'); %>
            <% if (hasCustomAvatar) { %>
              <img src="<%= currentUser.avatar %>" alt="<%= currentUser.name %>" class="profile-avatar-custom">
            <% } else { %>
              <div class="profile-brand-emblem-badge" title="SpendWise Brand Emblem">
                <img src="/images/logo.svg?v=fintech_v3" alt="SpendWise Logo" class="profile-brand-emblem-img">
              </div>
            <% } %>
          </div>
          <div style="flex: 1;">
            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
              <h3 style="font-size: 1.4rem; font-weight: 700; margin: 0; color: var(--text-main); font-family: 'Plus Jakarta Sans', sans-serif;"><%= currentUser.name %></h3>
              <span class="badge badge-success" style="font-size: 0.74rem;">
                <i class="fa-solid fa-circle-check"></i> Personal Account
              </span>
            </div>
            <span style="font-size: 0.88rem; color: var(--text-muted); display: block; margin: 4px 0;"><%= currentUser.email %></span>
            <span style="font-size: 0.82rem; color: var(--gold);"><i class="fa-solid fa-wallet"></i> Personal Finance</span>
            <div style="margin-top: 12px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
              <label class="btn btn-outline btn-sm" style="cursor: pointer;">
                <i class="fa-solid fa-camera"></i> Change Avatar
                <input type="file" name="avatar" accept="image/*" style="display: none;">
              </label>
              <a href="/auth/logout" class="btn btn-outline btn-sm" style="color: #FB7185; border-color: rgba(244, 63, 94, 0.35); gap: 6px;">
                <i class="fa-solid fa-arrow-right-from-bracket"></i> Log Out
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: Account Basics & Notifications -->
      <div class="glass-panel apple-reveal" style="padding: 32px; border-radius: 20px;">
        <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--text-main); margin-bottom: 20px; font-family: 'Outfit', sans-serif;">
          <i class="fa-solid fa-user-shield" style="color: var(--gold); margin-right: 8px;"></i> Personal Information
        </h3>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; margin-bottom: 20px;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label">Full Name</label>
            <input type="text" name="name" class="form-control" value="<%= currentUser.name %>" required>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label">Email Address (Read-only)</label>
            <input type="email" class="form-control" value="<%= currentUser.email %>" disabled style="opacity: 0.6;">
          </div>
        </div>

        <div style="background: var(--bg-surface-elevated); border: 1px solid var(--border-card); border-radius: 14px; padding: 20px;">
          <div style="font-size: 0.78rem; color: var(--gold); font-weight: 700; text-transform: uppercase; margin-bottom: 12px; letter-spacing: 0.04em;">
            <i class="fa-solid fa-bell"></i> Alerts & City
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" style="font-size: 0.82rem;">Mobile Number (Optional)</label>
              <input type="tel" name="phone_number" class="form-control" value="<%= currentUser.phone_number || '' %>" placeholder="e.g. +975 17123456">
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" style="font-size: 0.82rem;">City / Location (Optional)</label>
              <input type="text" name="dzongkhag" class="form-control" value="<%= currentUser.dzongkhag || '' %>" placeholder="e.g. Thimphu / Paro">
            </div>
          </div>
        </div>
      </div>

      <!-- Card 3: Currency, Monthly Inflow & Theme Palette -->
      <div class="glass-panel apple-reveal" style="padding: 32px; border-radius: 20px;">
        <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--text-main); margin-bottom: 20px; font-family: 'Outfit', sans-serif;">
          <i class="fa-solid fa-palette" style="color: var(--gold); margin-right: 8px;"></i> Financial Setup & Aesthetic Theme
        </h3>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; margin-bottom: 24px;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label">Preferred Currency Symbol</label>
            <select name="currency" class="form-control form-select">
              <option value="Nu." <%= currentUser.currency === 'Nu.' ? 'selected' : '' %>>Nu. (Bhutanese Ngultrum)</option>
              <option value="₹" <%= currentUser.currency === '₹' ? 'selected' : '' %>>₹ (INR)</option>
              <option value="$" <%= currentUser.currency === '$' ? 'selected' : '' %>>$ (USD)</option>
              <option value="€" <%= currentUser.currency === '€' ? 'selected' : '' %>>€ (EUR)</option>
            </select>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label">Estimated Monthly Inflow (Nu.)</label>
            <input type="number" step="0.01" name="monthly_income" class="form-control" value="<%= currentUser.monthly_income || 0 %>" style="font-weight: 600;">
          </div>
        </div>

        <!-- Aesthetic Color Palette Selection -->
        <div class="form-group" style="margin-bottom: 24px;">
          <label class="form-label"><i class="fa-solid fa-wand-magic-sparkles"></i> Select Aesthetic Theme Palette</label>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin-top: 10px;">
            <button type="button" class="btn btn-outline btn-sm theme-option-btn" onclick="window.SpendWise.setTheme('obsidian')" style="justify-content: flex-start; gap: 10px;">
              <span class="theme-swatch" style="background: linear-gradient(135deg, #000000 50%, #38BDF8 50%); border: 1px solid #38BDF8;"></span> Midnight Black
            </button>
            <button type="button" class="btn btn-outline btn-sm theme-option-btn" onclick="window.SpendWise.setTheme('royal')" style="justify-content: flex-start; gap: 10px;">
              <span class="theme-swatch" style="background: linear-gradient(135deg, #FFFFFF 50%, #10B981 50%); border: 1px solid #10B981;"></span> Emerald Mint (Light)
            </button>
            <button type="button" class="btn btn-outline btn-sm theme-option-btn" onclick="window.SpendWise.setTheme('pink')" style="justify-content: flex-start; gap: 10px;">
              <span class="theme-swatch" style="background: linear-gradient(135deg, #FBCFE8 50%, #EC4899 50%); border: 1px solid #EC4899;"></span> Sakura Blossom (Pink)
            </button>
            <button type="button" class="btn btn-outline btn-sm theme-option-btn" onclick="window.SpendWise.setTheme('lavender')" style="justify-content: flex-start; gap: 10px;">
              <span class="theme-swatch" style="background: linear-gradient(135deg, #DDD6FE 50%, #8B5CF6 50%); border: 1px solid #8B5CF6;"></span> Lavender Dream (Lilac)
            </button>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
          <a href="/auth/logout" class="btn btn-outline" style="color: #FB7185; border-color: rgba(244, 63, 94, 0.4); gap: 8px;">
            <i class="fa-solid fa-arrow-right-from-bracket"></i> Log Out
          </a>
          <button type="submit" class="btn btn-primary" style="width: 100%; max-width: 320px; justify-content: center;">
            <i class="fa-solid fa-floppy-disk"></i> Save Preferences & Security
          </button>
        </div>
      </div>
    </form>

    <!-- Card 4: Session & Security -->
    <div class="glass-panel apple-reveal" style="padding: 26px 32px; border-radius: 20px; margin-top: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; border-left: 4px solid #EF4444;">
      <div>
        <div style="font-family: 'Outfit', sans-serif; font-weight: 700; color: var(--text-main); font-size: 1.15rem; margin-bottom: 4px;">
          <i class="fa-solid fa-shield-halved" style="color: #EF4444; margin-right: 8px;"></i> Account Session & Security
        </div>
        <div style="font-size: 0.86rem; color: var(--text-muted);">
          Safely sign out of your SpendWise session on this device.
        </div>
      </div>
      <a href="/auth/logout" class="btn btn-outline" style="color: #FB7185; border-color: rgba(244, 63, 94, 0.45); gap: 8px;">
        <i class="fa-solid fa-arrow-right-from-bracket"></i> Log Out of SpendWise
      </a>
    </div>
  </div>
</main>

<%- include('partials/quick-add-modal') %>
<%- include('partials/zero-spending-modal') %>
<%- include('partials/footer') %>
