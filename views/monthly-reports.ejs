<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content">
  <div class="container">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 26px;">
      <div>
        <span class="badge badge-gold" style="margin-bottom: 6px;">
          <i class="fa-solid fa-stamp"></i> ROYAL FINANCIAL STATEMENT
        </span>
        <h1 style="font-size: 2.2rem; margin-bottom: 4px; color: var(--gold-pale);">End-of-Month Financial Statement</h1>
        <p style="color: var(--text-muted); font-size: 0.94rem;">Comprehensive automated summaries to evaluate previous spending and guide better habits.</p>
      </div>

      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <form action="/reports" method="GET" style="margin: 0;">
          <input type="month" name="month" class="form-control" value="<%= month %>" onchange="this.form.submit()" style="padding: 8px 16px; font-size: 0.92rem; width: auto; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 600;">
        </form>

        <form action="/reports/generate" method="POST" style="margin: 0;">
          <input type="hidden" name="month" value="<%= month %>">
          <button type="submit" class="btn btn-outline">
            <i class="fa-solid fa-rotate"></i> Recalculate Statement
          </button>
        </form>

        <button onclick="window.print()" class="btn btn-primary">
          <i class="fa-solid fa-print"></i> Print / Save PDF
        </button>
      </div>
    </div>

    <% if (query && query.generated) { %>
      <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); color: #34D399; padding: 14px 20px; border-radius: 12px; font-size: 0.94rem; margin-bottom: 22px; display: flex; align-items: center; gap: 10px; box-shadow: var(--shadow-sm);">
        <i class="fa-solid fa-circle-check"></i> Monthly statement calculated successfully for <%= month %>!
      </div>
    <% } %>

    <% if (currentReport) { %>
      <!-- Statement Card -->
      <div class="glass-panel" style="padding: 38px; border-radius: 20px; margin-bottom: 30px; position: relative; border: 2px solid var(--border-gold);">
        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-gold); padding-bottom: 24px; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
          <div style="display: flex; align-items: center; gap: 16px;">
            <img src="/images/logo.svg?v=fintech_v3" alt="SpendWise Logo" style="width: 52px; height: 52px; border-radius: 14px; border: 1px solid var(--border-gold); box-shadow: 0 0 16px var(--brand-glow);">
            <div>
              <h2 style="font-size: 1.6rem; margin: 0; color: var(--gold-pale);">Personal Financial Statement</h2>
              <span style="font-size: 0.88rem; color: var(--text-muted);">Period: <%= month %> &bull; Prepared for <%= currentUser.name %></span>
            </div>
          </div>
          <div>
            <span class="badge badge-gold" style="font-size: 0.88rem; padding: 6px 16px;">
              <i class="fa-solid fa-certificate"></i> Statement Verified
            </span>
          </div>
        </div>

        <!-- 4 Key Figures Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 30px;">
          <div class="glass-panel metric-card apple-reveal" style="border-top: 3px solid var(--gold);">
            <div class="metric-label"><i class="fa-solid fa-arrow-trend-up"></i> Total Period Inflow</div>
            <div class="metric-value" style="color: var(--gold-pale);">
              <%= currency %> <%= parseFloat(currentReport.total_income).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
            </div>
            <div class="metric-sub">Gross earnings in Ngultrum</div>
          </div>

          <div class="glass-panel metric-card apple-reveal" style="border-top: 3px solid #8C1C13;">
            <div class="metric-label"><i class="fa-solid fa-receipt"></i> Total Period Expenditure</div>
            <div class="metric-value" style="color: #FFFFFF;">
              <%= currency %> <%= parseFloat(currentReport.total_expense).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
            </div>
            <div class="metric-sub">Recorded living disbursements</div>
          </div>

          <div class="glass-panel metric-card apple-reveal" style="border-top: 3px solid <%= currentReport.net_savings >= 0 ? '#10B981' : '#E11D48' %>;">
            <div class="metric-label"><i class="fa-solid fa-vault"></i> Preserved Wealth Balance</div>
            <div class="metric-value" style="color: <%= currentReport.net_savings >= 0 ? '#34D399' : '#FB7185' %>;">
              <%= currency %> <%= parseFloat(currentReport.net_savings).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
            </div>
            <div class="metric-sub">Net surplus retained</div>
          </div>

          <div class="glass-panel metric-card apple-reveal" style="border-top: 3px solid #F59E0B;">
            <div class="metric-label"><i class="fa-solid fa-piggy-bank"></i> Preservation Ratio</div>
            <div class="metric-value" style="color: #FBBF24;">
              <%= currentReport.savings_rate %>%
            </div>
            <div class="metric-sub">Portion of wealth preserved</div>
          </div>
        </div>

        <!-- Detailed Breakdown Highlights -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 24px; margin-bottom: 30px;">
          <!-- Highest Spending Category -->
          <div class="apple-reveal" style="background: var(--bg-surface-elevated); border: 1px solid var(--border-card); border-radius: 14px; padding: 24px;">
            <div style="font-size: 0.82rem; color: var(--gold); font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">
              <i class="fa-solid fa-crown"></i> Prime Expenditure Category
            </div>
            <div style="font-size: 1.4rem; font-weight: 800; color: var(--text-main); font-family: 'Outfit', sans-serif; margin-bottom: 6px; letter-spacing: -0.02em;">
              <%= currentReport.highest_category_name || 'N/A' %>
            </div>
            <div style="font-size: 1.25rem; font-family: 'Outfit', sans-serif; font-weight: 700; color: var(--gold);">
              <%= currency %> <%= parseFloat(currentReport.highest_category_amount || 0).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
            </div>
            <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 10px; line-height: 1.5;">
              This sector absorbed the greatest share of disbursements during <%= month %>.
            </p>
          </div>

          <!-- Budget Exceeded Status -->
          <div class="apple-reveal" style="background: var(--bg-surface-elevated); border: 1px solid var(--border-card); border-radius: 14px; padding: 24px;">
            <div style="font-size: 0.82rem; color: var(--gold); font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">
              <i class="fa-solid fa-shield-halved"></i> Budget Ceiling Adherence
            </div>

            <% let exceeded = [];
               try { exceeded = JSON.parse(currentReport.exceeded_budgets_json || '[]'); } catch(e) {}
            %>

            <% if (exceeded.length > 0) { %>
              <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 8px;">
                <% exceeded.forEach(item => { %>
                  <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(140, 28, 19, 0.25); border: 1px solid var(--border-crimson); border-radius: 8px; padding: 10px 14px;">
                    <span style="font-weight: 600; font-size: 0.92rem; color: #FCA5A5;"><%= item.category %></span>
                    <span style="font-size: 0.84rem; color: #FFFFFF;">
                      Spent <%= currency %> <%= item.spent.toLocaleString() %> (Limit: <%= currency %> <%= item.budget.toLocaleString() %>)
                    </span>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div style="display: flex; align-items: center; gap: 12px; color: #34D399; margin-top: 12px;">
                <i class="fa-solid fa-circle-check" style="font-size: 1.6rem;"></i>
                <span style="font-size: 0.95rem; font-weight: 600;">Praiseworthy discipline! All spending categories remained within designated limits.</span>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Narrative Summary Box -->
        <div class="apple-reveal" style="background: var(--bg-surface-elevated); border: 1px solid var(--border-card); border-radius: 14px; padding: 24px; margin-bottom: 30px;">
          <h4 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 8px; color: #10B981; display: flex; align-items: center; gap: 10px; font-family: 'Outfit', sans-serif;">
            <i class="fa-solid fa-file-lines"></i> Monthly Financial Review
          </h4>
          <p style="color: var(--text-main); font-size: 0.96rem; line-height: 1.7; margin: 0;">
            <%= currentReport.report_summary %>
          </p>
        </div>

        <!-- Next Steps Bridge -->
        <div class="apple-reveal" style="text-align: center; border-top: 1px solid var(--border-card); padding-top: 26px;">
          <h4 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 8px; color: var(--text-main);">Smart Recommendations for the Coming Month</h4>
          <p style="color: var(--text-muted); font-size: 0.94rem; margin-bottom: 20px;">
            SpendWise has formulated rule-based suggestions based on these findings.
          </p>
          <a href="/suggestions?month=<%= month %>" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Review Next-Month Recommendations &rarr;
          </a>
        </div>
      </div>
    <% } else { %>
      <div class="glass-panel" style="padding: 48px 20px; text-align: center; color: var(--text-muted);">
        <i class="fa-solid fa-file-invoice" style="font-size: 3rem; margin-bottom: 14px; color: var(--gold); opacity: 0.5;"></i>
        <h3 style="font-family: 'Outfit', sans-serif; font-size: 1.35rem; font-weight: 700; margin-bottom: 6px; color: var(--text-main);">No Report Generated for <%= month %></h3>
        <p style="margin-bottom: 22px; max-width: 500px; margin-left: auto; margin-right: auto;">Compile all recorded expenses, budgets, and savings into a comprehensive monthly report.</p>
        <form action="/reports/generate" method="POST">
          <input type="hidden" name="month" value="<%= month %>">
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-chart-line"></i> Generate <%= month %> Report
          </button>
        </form>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/quick-add-modal') %>
<%- include('partials/zero-spending-modal') %>
<%- include('partials/footer') %>
