<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content">
  <div class="container">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 26px;">
      <div>
        <span class="badge badge-gold" style="margin-bottom: 6px;">
          <i class="fa-solid fa-gem"></i> FINANCIAL INSIGHTS & WISDOM
        </span>
        <h1 style="font-size: 2.2rem; margin-bottom: 4px; color: var(--gold-pale);">Personalized Next-Month Guidance</h1>
        <p style="color: var(--text-muted); font-size: 0.94rem;">
          Actionable rules derived from previous spending patterns to elevate your personal savings and financial clarity.
        </p>
      </div>

      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <form action="/suggestions" method="GET" style="margin: 0;">
          <input type="month" name="month" class="form-control" value="<%= month %>" onchange="this.form.submit()" style="padding: 8px 16px; font-size: 0.92rem; width: auto; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 600;">
        </form>

        <form action="/suggestions/refresh" method="POST" style="margin: 0;">
          <input type="hidden" name="month" value="<%= month %>">
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-arrows-rotate"></i> Re-Analyze Patterns
          </button>
        </form>
      </div>
    </div>

    <% if (query && query.refreshed) { %>
      <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); color: #34D399; padding: 14px 20px; border-radius: 12px; font-size: 0.94rem; margin-bottom: 22px; display: flex; align-items: center; gap: 10px; box-shadow: var(--shadow-sm);">
        <i class="fa-solid fa-circle-check"></i> Financial patterns re-analyzed! Fresh recommendations formulated for <%= month %>.
      </div>
    <% } else if (query && query.applied) { %>
      <div style="background: rgba(197, 160, 89, 0.15); border: 1px solid var(--border-gold); color: var(--gold-pale); padding: 14px 20px; border-radius: 12px; font-size: 0.94rem; margin-bottom: 22px; display: flex; align-items: center; gap: 10px;">
        <i class="fa-solid fa-circle-check"></i> Suggestion acknowledged! May your next month's financial mindfulness flourish.
      </div>
    <% } %>

    <!-- Potential Savings Banner -->
    <% 
      let totalPotentialSavings = 0;
      if (suggestions && suggestions.length > 0) {
        totalPotentialSavings = suggestions.reduce((acc, s) => acc + parseFloat(s.potential_saving || 0), 0);
      }
    %>
    <div class="glass-panel apple-reveal" style="padding: 26px 32px; margin-bottom: 30px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; border-top: 3px solid var(--gold);">
      <div style="display: flex; align-items: center; gap: 20px;">
        <div style="width: 58px; height: 58px; border-radius: 16px; background: rgba(197, 160, 89, 0.2); border: 1px solid var(--border-gold); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; color: var(--gold);">
          <i class="fa-solid fa-piggy-bank"></i>
        </div>
        <div>
          <div style="font-size: 0.82rem; color: var(--gold); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;">
            Identified Next-Month Savings Potential
          </div>
          <div style="font-size: 2rem; font-weight: 800; font-family: 'Outfit', sans-serif; color: var(--text-main); margin-top: 2px; letter-spacing: -0.02em;">
            +<%= currency %> <%= totalPotentialSavings.toLocaleString(undefined, {minimumFractionDigits: 2}) %>
          </div>
        </div>
      </div>
      <div>
        <span class="badge badge-gold" style="font-size: 0.88rem; padding: 8px 16px;">
          <i class="fa-solid fa-gem"></i> <%= suggestions ? suggestions.length : 0 %> Recommendations Active
        </span>
      </div>
    </div>

    <!-- Suggestions List -->
    <div style="display: flex; flex-direction: column; gap: 22px;">
      <% if (suggestions && suggestions.length > 0) { %>
        <% suggestions.forEach((s, idx) => { %>
          <div class="glass-panel apple-reveal" style="padding: 28px; border-left: 5px solid <%= s.action_type === 'expense_cut' ? '#8C1C13' : (s.action_type === 'budget_adjust' ? 'var(--gold)' : '#10B981') %>; opacity: <%= s.is_applied ? '0.78' : '1' %>;">
            <div style="display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 14px; margin-bottom: 14px;">
              <div>
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                  <span class="badge <%= s.action_type === 'expense_cut' ? 'badge-crimson' : (s.action_type === 'budget_adjust' ? 'badge-gold' : 'badge-success') %>">
                    <%= s.action_type === 'expense_cut' ? 'Mindful Expense Reduction' : (s.action_type === 'budget_adjust' ? 'Ceiling Re-alignment' : 'Wealth Strategy') %>
                  </span>
                  <span style="font-size: 0.8rem; color: var(--text-subtle);">Guidance #<%= idx + 1 %></span>
                </div>
                <h3 style="font-size: 1.35rem; margin: 0; color: var(--gold-pale);"><%= s.title %></h3>
              </div>

              <% if (s.potential_saving > 0) { %>
                <div style="text-align: right;">
                  <div style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600;">Savings Potential</div>
                  <div style="font-size: 1.4rem; font-family: 'Outfit', sans-serif; font-weight: 800; color: #34D399; letter-spacing: -0.02em;">
                    +<%= currency %> <%= parseFloat(s.potential_saving).toLocaleString() %>
                  </div>
                </div>
              <% } %>
            </div>

            <!-- Comparison Table Component: Current Pattern vs Next-Month Suggestion -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin: 18px 0; background: rgba(0, 0, 0, 0.25); border: 1px solid var(--border-gold); border-radius: 12px; padding: 18px;">
              <div>
                <div style="font-size: 0.78rem; text-transform: uppercase; font-weight: 700; color: #FCA5A5; margin-bottom: 6px;">
                  <i class="fa-solid fa-chart-line-down"></i> Current Spending Pattern
                </div>
                <div style="font-size: 0.94rem; color: var(--text-muted); line-height: 1.5;">
                  <%= s.current_pattern %>
                </div>
              </div>

              <div>
                <div style="font-size: 0.78rem; text-transform: uppercase; font-weight: 700; color: #34D399; margin-bottom: 6px;">
                  <i class="fa-solid fa-arrow-right"></i> Next-Month Mindful Guidance
                </div>
                <div style="font-size: 0.98rem; font-weight: 600; color: #FFFFFF; line-height: 1.5;">
                  <%= s.suggestion_text %>
                </div>
              </div>
            </div>

            <!-- Action buttons -->
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 14px;">
              <span style="font-size: 0.82rem; color: var(--text-subtle);">
                Formulated based on historical variance rules in Ngultrum.
              </span>

              <% if (s.is_applied) { %>
                <span class="badge badge-success" style="font-size: 0.85rem; padding: 6px 14px;">
                  <i class="fa-solid fa-check"></i> Applied to Mindful Plan
                </span>
              <% } else { %>
                <form action="/suggestions/apply/<%= s.id %>" method="POST" style="margin: 0;">
                  <button type="submit" class="btn btn-outline btn-sm">
                    <i class="fa-solid fa-check"></i> Mark as Embraced
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="glass-panel" style="padding: 48px 20px; text-align: center; color: var(--text-muted);">
          <i class="fa-solid fa-gem" style="font-size: 3rem; margin-bottom: 14px; color: var(--gold); opacity: 0.5;"></i>
          <h3 style="font-family: 'Outfit', sans-serif; font-size: 1.35rem; font-weight: 700; margin-bottom: 6px; color: var(--text-main);">No Suggestions Yet</h3>
          <p style="margin-bottom: 22px; max-width: 500px; margin-left: auto; margin-right: auto;">Log your expenses to receive personalized recommendations for <%= month %>.</p>
          <form action="/suggestions/refresh" method="POST">
            <input type="hidden" name="month" value="<%= month %>">
            <button type="submit" class="btn btn-primary">
              <i class="fa-solid fa-wand-magic-sparkles"></i> Generate Insights
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/quick-add-modal') %>
<%- include('partials/zero-spending-modal') %>
<%- include('partials/footer') %>
