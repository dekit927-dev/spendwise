<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content" style="display: flex; align-items: center; justify-content: center; min-height: 70vh;">
  <div class="container" style="max-width: 540px; text-align: center;">
    <div class="glass-panel apple-reveal" style="padding: 48px 36px; border-radius: 24px; border: 1px solid var(--border-card); box-shadow: var(--shadow-lg);">
      <div style="width: 72px; height: 72px; margin: 0 auto 20px; border-radius: 20px; background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); display: flex; align-items: center; justify-content: center; font-size: 2rem; color: #F87171;">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div style="font-size: 3.5rem; font-family: 'Outfit', sans-serif; font-weight: 800; color: #FCA5A5; line-height: 1; margin-bottom: 12px; letter-spacing: -0.04em;">
        <%= statusCode || 500 %>
      </div>
      <h2 style="font-size: 1.5rem; margin-bottom: 12px; color: var(--text-main); font-weight: 700;">Something Went Wrong</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 28px; line-height: 1.6;">
        <%= message || 'An unexpected issue occurred while loading this page. Please try again or return to the dashboard.' %>
      </p>
      <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary">
          <i class="fa-solid fa-house"></i> Return Home
        </a>
        <a href="javascript:history.back()" class="btn btn-outline">
          <i class="fa-solid fa-arrow-left"></i> Go Back
        </a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
