# SpendWise - Smart Personal Finance & Expense Tracking System
# Copy this file to .env and adjust credentials as needed

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=spendwise_gamified_secure_session_key_2026
JWT_SECRET=spendwise_jwt_super_token_signature_key_2026

DEFAULT_CURRENCY=Nu.
CURRENCY_CODE=BTN

# DB_TYPE can be 'postgres' or 'mysql'
DB_TYPE=postgres

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spendwise_db
DB_USER=postgres
DB_PASS=dekitshomo
DB_SSL=false

# MySQL Connection (if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_NAME=spendwise_db
MYSQL_USER=root
MYSQL_PASS=root
